---
import type { GetStaticPaths } from "astro";
import { collectTags, getPosts, tagSlug } from "../../../lib/posts";
import TagView from "../../../components/views/TagView.astro";

export const getStaticPaths = (async () => {
  const posts = await getPosts("ru");
  return collectTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, slug, posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === slug)) },
  }));
}) satisfies GetStaticPaths;

const { tag, slug, posts } = Astro.props;
---

<TagView lang="ru" tag={tag} slug={slug} posts={posts} />
