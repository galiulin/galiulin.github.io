---
import { Image } from "astro:assets";
import { readingTimeLabel, type Lang } from "../i18n/ui";
import { localeUrl } from "../i18n/urls";
import { readingTime, slugOf, type Post } from "../lib/posts";
import FormattedDate from "./FormattedDate.astro";
import TagPill from "./TagPill.astro";

interface Props {
  post: Post;
  lang: Lang;
  /** Position within a `.post-grid` — drives the scroll-reveal stagger delay. Ignored elsewhere. */
  index?: number;
  /** Lighter-weight variant for secondary contexts (e.g. the post page's "related posts") —
   * no cover, no tags, smaller type. Same border/radius/hover language as the full card. */
  compact?: boolean;
  /** Heavier variant for the home page's pinned post — larger type, roomier padding.
   * Mutually exclusive with `compact`. */
  featured?: boolean;
}

const { post, lang, index = 0, compact = false, featured = false } = Astro.props;
const href = localeUrl(lang, `blog/${slugOf(post)}`);
const cover = post.data.coverImage;
---

<article
  class="post-card group relative flex flex-col overflow-hidden rounded border border-border bg-surface transition-colors hover:border-accent-dim"
  style={`--i: ${index}`}
>
  {
    !compact && cover && (
      <div class="aspect-video overflow-hidden border-b border-border">
        <Image
          src={cover}
          alt={post.data.title}
          width={640}
          height={360}
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class:list={["flex flex-1 flex-col", compact ? "p-4" : featured ? "p-6 sm:p-8" : "p-5"]}>
    <p class:list={["font-mono text-accent-dim", compact ? "text-[10px]" : "text-[11px]"]}>
      blog/{slugOf(post)}.md
    </p>

    <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-muted">
      <FormattedDate date={post.data.pubDate} lang={lang} />
      <span aria-hidden="true">·</span>
      <span>{readingTimeLabel(lang, readingTime(post))}</span>
      {post.data.draft && <span class="text-accent">draft</span>}
    </div>

    <h2
      class:list={[
        "mt-2 font-semibold text-strong",
        compact ? "text-base" : featured ? "text-xl sm:text-2xl" : "text-lg",
      ]}
    >
      <a href={href} class="transition-colors group-hover:text-accent">{post.data.title}</a>
    </h2>

    <p
      class:list={[
        "mt-2 flex-1 leading-relaxed text-muted",
        compact ? "text-xs" : featured ? "text-base" : "text-sm",
      ]}
    >
      {post.data.description}
    </p>

    {
      !compact && post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <TagPill tag={tag} lang={lang} />
          ))}
        </div>
      )
    }
  </div>
</article>
