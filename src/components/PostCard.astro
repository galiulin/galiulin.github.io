---
import { readingTimeLabel, type Lang } from "../i18n/ui";
import { localeUrl } from "../i18n/urls";
import { readingTime, slugOf, type Post } from "../lib/posts";
import FormattedDate from "./FormattedDate.astro";
import TagPill from "./TagPill.astro";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const href = localeUrl(lang, `blog/${slugOf(post)}`);
---

<article class="group border-b border-border py-7 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
    <FormattedDate date={post.data.pubDate} lang={lang} />
    <span aria-hidden="true">·</span>
    <span>{readingTimeLabel(lang, readingTime(post))}</span>
    {post.data.draft && <span class="text-accent">draft</span>}
  </div>

  <h2 class="mt-2 text-xl font-semibold text-strong">
    <a href={href} class="transition-colors group-hover:text-accent">{post.data.title}</a>
  </h2>

  <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>

  {
    post.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => (
          <TagPill tag={tag} lang={lang} />
        ))}
      </div>
    )
  }
</article>
