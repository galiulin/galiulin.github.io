---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { langs, readingTimeLabel, useTranslations, type Lang } from "../../i18n/ui";
import { localeUrl, ogImageUrl, type Alternates } from "../../i18n/urls";
import { getPosts, getTranslation, readingTime, relatedPosts, slugOf, type Post } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import FormattedDate from "../FormattedDate.astro";
import Mermaid from "../Mermaid.astro";
import PostCard from "../PostCard.astro";
import TagPill from "../TagPill.astro";
import TableOfContents from "../react/TableOfContents";

interface Props {
  lang: Lang;
  post: Post;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content, headings } = await render(post);

const translation = await getTranslation(post);
const related = relatedPosts(post, await getPosts(lang));
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

// Languages without a translation of this post point at their blog index instead.
const alternates = Object.fromEntries(
  langs.map((code) => {
    if (code === lang) return [code, { href: localeUrl(code, `blog/${slugOf(post)}`), translated: true }];
    if (translation)
      return [code, { href: localeUrl(code, `blog/${slugOf(translation)}`), translated: true }];
    return [code, { href: localeUrl(code, "blog"), translated: false }];
  }),
) as Alternates;
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternates={alternates}
  ogType="article"
  image={post.data.coverImage?.src ?? ogImageUrl(`${lang}/${slugOf(post)}`)}
>
  <Breadcrumbs
    items={[
      { label: t("nav.home"), href: localeUrl(lang) },
      { label: t("blog.title"), href: localeUrl(lang, "blog") },
      { label: post.data.title },
    ]}
  />

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-10">
    <article
      data-pagefind-body
      id="article-tile"
      data-copy={t("code.copy")}
      data-copied={t("code.copied")}
      class="article-tile min-w-0 rounded border border-border bg-surface px-5 pt-6 pb-8 sm:px-9 sm:pt-8 sm:pb-10"
    >
      <p class="font-mono text-[11px] text-accent-dim">blog/{slugOf(post)}.md</p>

      <h1 class="mt-4 text-3xl leading-tight font-semibold text-strong">{post.data.title}</h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
        <FormattedDate date={post.data.pubDate} lang={lang} />
        <span aria-hidden="true">·</span>
        <span>{readingTimeLabel(lang, readingTime(post))}</span>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t("blog.updated")} <FormattedDate date={post.data.updatedDate} lang={lang} />
              </span>
            </>
          )
        }
        {
          translation && (
            <>
              <span aria-hidden="true">·</span>
              {/* De-emphasized on purpose — metadata, not a call to action, so it doesn't
                  compete with the title. Brightens to full accent only on hover/focus. */}
              <a
                href={alternates[translation.data.lang].href}
                data-pagefind-ignore
                class="inline-flex items-center gap-1 text-accent-dim opacity-75 transition-opacity hover:text-accent hover:opacity-100"
              >
                <span aria-hidden="true">⇄</span>
                {t("blog.translation")}
              </a>
            </>
          )
        }
      </div>

      {
        toc.length > 2 && (
          <details class="mt-6 rounded border border-border bg-raised px-4 py-3 lg:hidden" data-pagefind-ignore>
            <summary class="cursor-pointer font-mono text-[10px] tracking-widest text-muted uppercase">
              {t("blog.toc")}
            </summary>
            <ul class="mt-3 space-y-1.5 text-sm">
              {toc.map((heading) => (
                <li style={`padding-left: ${(heading.depth - 2) * 0.75}rem`}>
                  <a href={`#${heading.slug}`} class="text-muted transition-colors hover:text-accent">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      {
        post.data.coverImage && (
          <Image
            src={post.data.coverImage}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 48rem, 100vw"
            class="mt-8 w-full rounded border border-border"
          />
        )
      }

      <div class="prose mt-10">
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="mt-12 flex flex-wrap gap-1.5 border-t border-border pt-6" data-pagefind-ignore>
            {post.data.tags.map((tag) => (
              <TagPill tag={tag} lang={lang} />
            ))}
          </div>
        )
      }
    </article>

    {
      toc.length > 2 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
            <TableOfContents headings={toc} title={t("blog.toc")} client:visible />
          </div>
        </aside>
      )
    }
  </div>

  {
    related.length > 0 && (
      <section class="mt-10" data-pagefind-ignore>
        <h2 class="font-mono text-[10px] tracking-widest text-muted uppercase">{t("blog.related")}</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {related.map((item) => (
            <PostCard post={item} lang={lang} compact />
          ))}
        </div>
      </section>
    )
  }

  <Mermaid />

  <script>
    // A "copy" button on every code block (mermaid diagrams excluded — they're replaced by an
    // <svg> before this runs). The <pre> scrolls horizontally, so the button can't live inside
    // it; each <pre> is wrapped in a positioned <div> that the button is pinned to instead.
    const article = document.getElementById("article-tile");
    const copyLabel = article?.dataset.copy ?? "Copy";
    const copiedLabel = article?.dataset.copied ?? "Copied";

    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      const code = pre.querySelector("code");
      if (!code || code.classList.contains("language-mermaid")) continue;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";
      pre.replaceWith(wrapper);
      wrapper.append(pre);

      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-btn";
      button.textContent = copyLabel;
      button.setAttribute("aria-label", copyLabel);

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.innerText.replace(/\n$/, ""));
          button.textContent = copiedLabel;
          button.classList.add("copied");
          setTimeout(() => {
            button.textContent = copyLabel;
            button.classList.remove("copied");
          }, 1600);
        } catch {
          /* clipboard blocked — nothing useful to do */
        }
      });

      wrapper.append(button);
    }
  </script>

  <script>
    // The tile "unfolds" once on load — a plain fade + scale-in, not scroll-triggered
    // (there's only one block on the page). Two rAFs so the browser paints the
    // pre-transition state first, or the transition never has anything to animate from.
    const tile = document.getElementById("article-tile");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (tile) {
      if (reduceMotion) {
        tile.classList.add("in-view");
      } else {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => tile.classList.add("in-view"));
        });
      }
    }
  </script>
</BaseLayout>
